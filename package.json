{
  "name": "fluxlab-cfd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free browser CFD workbench with WebGPU D2Q9 TRT/BGK compute and visualization",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python3 tests/browser.py",
